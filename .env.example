# Copy to .env and adjust. Every line is optional; the value shown is the default unless it says "example".

# --- Library ----------------------------------------------------------------------------------------------------
# Folder with your 3MF/STL files on this machine. Mounted read-only; the site never changes it.
LIBRARY_DIR=./library

# Or an NFS share instead (then LIBRARY_DIR is ignored):
# COMPOSE_FILE=docker-compose.yml:compose.nfs.yml
# NFS_SERVER=192.168.1.10                 # example
# NFS_EXPORT=/volume1/3d-models           # example
# NFS_VERSION=4.1

# --- Access -----------------------------------------------------------------------------------------------------
# Visitors coming straight from these networks need no login (';'-separated). Leave empty to require a login for
# everyone. Requests through a reverse proxy always need one.
TRUSTED_NETWORKS=
# TRUSTED_NETWORKS=192.168.1.0/24         # example

# Your reverse proxy's IP address(es), so the app sees visitors' real addresses and HTTPS. Only set this when the
# site is behind a proxy.
KNOWN_PROXIES=

# --- Container --------------------------------------------------------------------------------------------------
# Port on this machine.
PORT=8085
# The user and group the app runs as: needs read access to the library and write access to ./data.
PUID=1000
PGID=1000
# Memory cap for the container.
MEMORY_LIMIT=3g
# Image to run. Pin a version (e.g. :1.0.0) for predictable updates.
IMAGE=ghcr.io/jurjen74/3mf-library:latest
# missing = pull once, always = check on every `up`, never = only use a local image.
PULL_POLICY=missing

# --- Site -------------------------------------------------------------------------------------------------------
SITE_TITLE=3D Print library
# Time zone for dates on the site.
TZ=UTC
# TZ=Europe/Amsterdam                     # example

# How often the library is checked for changes, and how long a new file must stay unchanged before it's read
# (sync tools write in parts). Empty = default (00:03:00 and 00:00:10).
SCAN_INTERVAL=
SETTLE_DELAY=
# Names to skip, ';'-separated globs, quoted because of the '#'. Empty = the built-in list (shown here).
# IGNORE="datapackage.json;._*;@eaDir;#recycle;#snapshot;Thumbs.db;desktop.ini;*.tmp"

# Once a day the site asks GitHub for the latest release and shows "x.y.z available" in the footer when it's newer.
# Nothing about your site or library is sent. Set to false to turn this off.
UPDATE_CHECK=
