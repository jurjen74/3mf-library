@page "/favourites"
@model FavouritesModel
@using Library.Web.Pages.Shared

<main class="content">
    <h1>Favourites</h1>
    <p class="muted lead">
        @(Model.Shared
            ? "Shared by everyone using the library on the home network without logging in."
            : "Only you see these. Star a model on its card or its page to add it.")
    </p>

    @if (Model.Models.Count + Model.OtherFiles.Count == 0)
    {
        <div class="empty-state empty-state--compact">
            <svg class="empty-state-icon" viewBox="0 0 64 64" aria-hidden="true">
                <path d="m32 8 7.4 15 16.6 2.4-12 11.7 2.8 16.5L32 45.8l-14.8 7.8L20 37.1 8 25.4l16.6-2.4L32 8Z" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
                <path d="M50 8v8M46 12h8M12 46v6M9 49h6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
            <h2>No favourites yet</h2>
            <p class="muted">Tap the star on a model's card or page to keep it here, so it's one click away next time.</p>
            <div class="empty-state-actions">
                <a class="button primary" href="/browse">Browse the library</a>
                <a class="button" href="/recent">See what's new</a>
            </div>
        </div>
    }

    @if (Model.Models.Count > 0)
    {
        <section>
            <h2 class="section-title">Models <span>@Model.Models.Count</span></h2>
            <div class="card-grid">
                @foreach (var file in Model.Models)
                {
                    <partial name="_ModelCard" model="new ModelCard(file, ShowFolder: true)" />
                }
            </div>
        </section>
    }

    @if (Model.OtherFiles.Count > 0)
    {
        <section>
            <h2 class="section-title">Other files <span>@Model.OtherFiles.Count</span></h2>
            <ul class="file-list">
                @foreach (var file in Model.OtherFiles)
                {
                    <li>
                        <span class="file-icon kind--@file.Kind">@(System.IO.Path.GetExtension(file.Name).TrimStart('.').ToUpperInvariant())</span>
                        <a class="file-list-name" href="@Display.FileUrl(file.Path)" title="@file.Path">@file.Path</a>
                        <partial name="_FileSize" model="file" />
                    </li>
                }
            </ul>
        </section>
    }
</main>
