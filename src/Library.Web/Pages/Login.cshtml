@page "/login"
@model LoginModel
@inject LibraryOptions Options

<main class="content login-page">
    <form class="login-card" method="post">
        <svg class="login-logo" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3ZM5 9.7l6 3.3v6.6l-6-3.3V9.7Zm8 9.9V13l6-3.3v6.6l-6 3.3Z" fill="currentColor"/></svg>
        <h1>@Options.SiteTitle</h1>

        @if (Model.NoAccounts)
        {
            <p class="notice">No account has been created yet. Open this site directly on its own address (not through a proxy) to create one.</p>
        }

        @if (Model.Error is not null)
        {
            <p class="login-error" role="alert">@Model.Error</p>
        }

        <label>
            <span>User name</span>
            <input asp-for="UserName" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
        </label>
        <label>
            <span>Password</span>
            <input asp-for="Password" type="password" autocomplete="current-password" required>
        </label>
        <label class="remember">
            <input asp-for="Remember" type="checkbox">
            <span>Keep me logged in on this device</span>
        </label>
        <button type="submit" class="button primary">Log in</button>
    </form>
</main>
