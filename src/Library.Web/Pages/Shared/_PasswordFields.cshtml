@model AccountModel
@if (Model.Error is not null)
{
    <p class="login-error" role="alert">@Model.Error</p>
}
<label>
    <span>@(Model.Required ? "Password you logged in with" : "Current password")</span>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required autofocus="@Model.Required">
</label>
<label>
    <span>New password <small class="muted">(at least @UserStore.MinimumPasswordLength characters)</small></span>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" minlength="@UserStore.MinimumPasswordLength" required>
</label>
<label>
    <span>New password again</span>
    <input asp-for="RepeatPassword" type="password" autocomplete="new-password" minlength="@UserStore.MinimumPasswordLength" required>
</label>
