@using Library.Web.Pages.Shared
@model ModelCard
@{
    var file = Model.File;
    var title = Display.Title(file);
    var url = Display.FileUrl(file.Path);
}
<article class="card">
    <a class="card-thumb" href="@url" aria-label="@title">
        @if (file.CacheKey is not null && file.Cover is not null)
        {
            <img src="@Display.ImageUrl(file.CacheKey, file.Cover)" alt="" loading="lazy" width="512" height="512">
        }
        else
        {
            <div class="placeholder">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3ZM5 9.7l6 3.3v6.6l-6-3.3V9.7Zm8 9.9V13l6-3.3v6.6l-6 3.3Z" fill="currentColor"/></svg>
                <span>@(file.Error is not null ? "Could not read file" : file.Kind == FileKinds.Stl ? "STL · no preview yet" : "No preview")</span>
            </div>
        }
        @if (file.PlateCount > 1)
        {
            <span class="badge">@file.PlateCount plates</span>
        }
        @if (file.Kind != FileKinds.ThreeMf)
        {
            <span class="kind kind--@file.Kind">@file.Kind.ToUpperInvariant()</span>
        }
    </a>
    <div class="card-body">
        <h3 title="@title"><a href="@url">@title</a></h3>
        <p class="file-name" title="@file.Name">@file.Name</p>
        @if (Model.ShowFolder)
        {
            <p class="card-folder"><a href="@Display.BrowseUrl(file.Folder)" title="@(file.Folder.Length == 0 ? "Library" : file.Folder)">@(file.Folder.Length == 0 ? "Library" : file.Folder)</a></p>
        }
        @if (file.Designer is not null)
        {
            <p class="muted">by @file.Designer</p>
        }
        @if (file.Error is not null)
        {
            <p class="warn" title="@file.Error">@file.Error</p>
        }
        <div class="card-foot">
            <partial name="_Swatches" model="file.ColourList.Take(8).ToList()" />
            <a class="download" href="@Display.DownloadUrl(file.Path)" download title="Download @file.Name">
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                @Display.Size(file.Size)
            </a>
        </div>
    </div>
</article>
