@using Library.Web.Auth
@inject LibraryOptions Options
@inject IndexerService Indexer
@inject LibraryQueries Queries
@inject UserStore Users
@{
    // The login and error pages are shown to visitors who aren't logged in: no library details there.
    var signedIn = User.Identity?.IsAuthenticated == true && ViewData["Anonymous"] is not true;
    var stats = signedIn ? Queries.Stats() : null;
    var status = Indexer.Status;
    var returnPath = ViewData["FolderPath"] as string ?? "";
    var homeNetwork = TrustedNetwork.IsHomeNetworkUser(User);
    var offerSetup = stats is not null && homeNetwork && !Users.HasUsers();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>@ViewData["Title"] · @Options.SiteTitle</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/browse">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3ZM5 9.7l6 3.3v6.6l-6-3.3V9.7Zm8 9.9V13l6-3.3v6.6l-6 3.3Z" fill="currentColor"/></svg>
            <span>@Options.SiteTitle</span>
        </a>
        @if (stats is not null)
        {
            <form class="topbar-search" action="/search" method="get" role="search">
                <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <input type="search" name="q" value="@(ViewData["Query"] as string)" placeholder="Search models" aria-label="Search the library" accesskey="k">
            </form>
            <nav class="topbar-nav">
                <a href="/recent">Recent</a>
                <span class="topbar-stats">@Display.Plural(stats.ThreeMf, "3MF", "3MFs") · @Display.Plural(stats.Stl, "STL", "STLs")</span>
                @if (homeNetwork)
                {
                    <a class="session-pill" href="/account" title="You're on the home network, so no login is needed">Home network</a>
                }
                else
                {
                    <a href="/account" title="Your account">@User.Identity?.Name</a>
                    <form method="post" action="/logout" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="link-button">Log out</button>
                    </form>
                }
            </nav>
        }
    </header>

    @if (offerSetup)
    {
        <div class="setup-banner">
            No account yet. <a href="/setup">Create one</a> to open the library away from home.
        </div>
    }

    <div class="shell @(ViewData["ShellClass"] as string)">
        @RenderBody()
    </div>

    @if (stats is not null)
    {
        <footer class="footer">
            <span>
                @if (status.Scanning)
                {
                    <text>Scanning the library…</text>
                }
                else if (status.LastResult is { LibraryOnline: false })
                {
                    <strong class="warn">Library folder unavailable</strong><text> · showing the last index</text>
                }
                else
                {
                    <text>Last scan @Display.Ago(status.LastFinished)</text>
                }
                @if (stats.Errors > 0)
                {
                    <text> · </text><span class="warn">@Display.Plural(stats.Errors, "file", "files") could not be read</span>
                }
            </span>
            <form method="post" asp-page="/Browse" asp-page-handler="Rescan" asp-route-path="">
                <input type="hidden" name="returnPath" value="@returnPath">
                <button type="submit" class="link-button">Rescan now</button>
            </form>
        </footer>
    }
</body>
</html>
