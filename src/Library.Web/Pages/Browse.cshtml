@page "/browse/{**path}"
@model BrowseModel
@{
    var isRoot = Model.FolderPath.Length == 0;
    var isEmpty = Model.Subfolders.Count + Model.Models.Count + Model.OtherFiles.Count == 0;
}

<aside class="sidebar">
    <details class="tree-panel" open>
        <summary>Folders</summary>
        <nav class="tree" aria-label="Folders">
            <div class="leaf root">
                <a href="/browse" aria-current="@(isRoot ? "page" : null)">Library</a>
                <span class="count">@Model.Tree.ModelCount</span>
            </div>
            <partial name="_FolderTree" model="Model.Tree" />
        </nav>
    </details>
</aside>

<main class="content">
    @if (Model.StillIndexing)
    {
        <div class="notice" data-reload="3">
            <strong>Indexing the library…</strong>
            The first scan reads every file once. This page reloads by itself.
        </div>
    }
    else
    {
        <nav class="crumbs" aria-label="Breadcrumb">
            @for (var i = 0; i < Model.Crumbs.Count; i++)
            {
                var crumb = Model.Crumbs[i];
                if (i == Model.Crumbs.Count - 1)
                {
                    <span aria-current="page">@crumb.Name</span>
                }
                else
                {
                    <a href="@Display.BrowseUrl(crumb.Path)">@crumb.Name</a>
                    <span class="sep" aria-hidden="true">/</span>
                }
            }
        </nav>

        <div class="folder-head">
            <h1>@(isRoot ? "Library" : Model.FolderName)</h1>
            @if (Model.Totals.Files > 0)
            {
                <a class="button" href="@Display.ZipUrl(Model.FolderPath)" download
                   title="Everything in this folder and its sub-folders as one ZIP"
                   data-confirm="@(Model.Totals.Bytes > 1024L * 1024 * 1024 ? $"This ZIP will be {Display.Size(Model.Totals.Bytes)}. Download it?" : null)">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11m0 0 4.5-4.5M12 14l-4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Download folder <span class="muted">· @Display.Plural(Model.Totals.Files, "file", "files") · @Display.Size(Model.Totals.Bytes)</span>
                </a>
            }
        </div>

        @if (Model.Subfolders.Count > 0)
        {
            <section>
                <h2 class="section-title">Folders <span>@Model.Subfolders.Count</span></h2>
                <div class="folder-grid">
                    @foreach (var tile in Model.Subfolders)
                    {
                        <a class="folder-tile" href="@Display.BrowseUrl(tile.Folder.Path)">
                            <div class="mosaic mosaic--@Math.Min(tile.Covers.Count, 4)">
                                @foreach (var cover in tile.Covers)
                                {
                                    <img src="@Display.ImageUrl(cover.CacheKey, cover.CoverSmall)" alt="" loading="lazy" width="128" height="128">
                                }
                                @if (tile.Covers.Count == 0)
                                {
                                    <svg class="folder-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Z" fill="currentColor"/></svg>
                                }
                            </div>
                            <div class="folder-meta">
                                <span class="folder-name">@tile.Folder.Name</span>
                                <span class="muted">@Display.Plural(tile.Folder.ModelCount, "model", "models")</span>
                            </div>
                        </a>
                    }
                </div>
            </section>
        }

        @if (Model.Models.Count > 0)
        {
            <section>
                <h2 class="section-title">Models <span>@Model.Models.Count</span></h2>
                <div class="card-grid">
                    @foreach (var file in Model.Models)
                    {
                        <partial name="_ModelCard" model="new Library.Web.Pages.Shared.ModelCard(file)" />
                    }
                </div>
            </section>
        }

        @if (Model.OtherFiles.Count > 0)
        {
            <section>
                <h2 class="section-title">Other files <span>@Model.OtherFiles.Count</span></h2>
                <ul class="file-list">
                    @foreach (var file in Model.OtherFiles)
                    {
                        <li>
                            @if (file.Kind == FileKinds.Image)
                            {
                                <img class="file-thumb" src="@Display.DownloadUrl(file.Path)" alt="" loading="lazy" width="40" height="40">
                            }
                            else
                            {
                                <span class="file-icon kind--@file.Kind">@(System.IO.Path.GetExtension(file.Name).TrimStart('.').ToUpperInvariant())</span>
                            }
                            <a class="file-list-name" href="@Display.FileUrl(file.Path)" title="@file.Name">@file.Name</a>
                            <a class="download" href="@Display.DownloadUrl(file.Path)" download title="Download @file.Name">@Display.Size(file.Size)</a>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (isEmpty)
        {
            <p class="empty">This folder is empty.</p>
        }
    }
</main>
