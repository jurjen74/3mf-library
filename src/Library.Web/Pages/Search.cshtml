@page "/search"
@model SearchModel
@using Library.Web.Pages.Shared

<main class="content">
    <h1>Search</h1>

    <form class="search-large" action="/search" method="get" role="search">
        <input type="search" name="q" value="@Model.Query" placeholder="Name, title, designer, folder or part…" aria-label="Search the library" autofocus>
        <button type="submit" class="button primary">Search</button>
    </form>

    @if (Model.Query.Length > 0)
    {
        @if (Model.Folders.Count + Model.List.Models.Count + Model.OtherFiles.Count == 0 && !Model.List.Filtered)
        {
            <div class="empty-state empty-state--compact">
                <svg class="empty-state-icon" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="28" cy="28" r="16" fill="none" stroke="currentColor" stroke-width="2.5"/>
                    <path d="m40 40 14 14" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
                    <path d="M22 26c1.5-2 4-2 5.5 0M29.5 26c1.5-2 4-2 5.5 0M23 34.5c3-2.5 7-2.5 10 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
                </svg>
                <h2>Nothing matches “@Model.Query”</h2>
                <p class="muted">
                    Words match the start of names, so “lamp” finds “Lampshade” but “shade” does not. Try a shorter word,
                    a designer, or the name of a part.
                </p>
                <div class="empty-state-actions">
                    <a class="button" href="/browse">Browse the library</a>
                    <a class="button" href="/recent">See what's new</a>
                </div>
            </div>
        }

        @if (Model.Folders.Count > 0)
        {
            <section>
                <h2 class="section-title">Folders <span>@Model.Folders.Count</span></h2>
                <ul class="folder-results">
                    @foreach (var folder in Model.Folders)
                    {
                        <li>
                            <a href="@Display.BrowseUrl(folder.Path)">
                                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5v-11Z" fill="currentColor"/></svg>
                                <span>@folder.Path</span>
                            </a>
                            <span class="muted">@Display.Plural(folder.ModelCount, "model", "models")</span>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (Model.List.SortOptions.Count + Model.List.TypeOptions.Count > 0)
        {
            <div class="list-toolbar">
                <partial name="_ListControls" model="Model.List" />
            </div>
        }

        @if (Model.List.Models.Count > 0)
        {
            <section>
                <h2 class="section-title">Models <span>@Model.List.Models.Count@(Model.Truncated ? "+" : "")</span></h2>
                <div class="card-grid">
                    @foreach (var file in Model.List.Models)
                    {
                        <partial name="_ModelCard" model="new ModelCard(file, ShowFolder: true)" />
                    }
                </div>
            </section>
        }

        @if (Model.OtherFiles.Count > 0)
        {
            <section>
                <h2 class="section-title">Other files <span>@Model.OtherFiles.Count</span></h2>
                <ul class="file-list">
                    @foreach (var file in Model.OtherFiles)
                    {
                        <li>
                            <span class="file-icon kind--@file.Kind">@(System.IO.Path.GetExtension(file.Name).TrimStart('.').ToUpperInvariant())</span>
                            <a class="file-list-name" href="@Display.FileUrl(file.Path)" title="@file.Path">@file.Path</a>
                            <a class="download" href="@Display.DownloadUrl(file.Path)" download title="Download @file.Name">@Display.Size(file.Size)</a>
                        </li>
                    }
                </ul>
            </section>
        }
    }
</main>
