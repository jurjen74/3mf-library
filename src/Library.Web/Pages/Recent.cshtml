@page "/recent"
@model RecentModel
@using Library.Web.Pages.Shared
@{
    var today = DateOnly.FromDateTime(DateTime.Now);
    var culture = System.Globalization.CultureInfo.InvariantCulture;
}

<main class="content">
    <h1>Recent</h1>
    <p class="muted lead">The @RecentModel.Count most recently modified models, newest first.</p>

    @if (Model.Models.Count == 0)
    {
        <p class="empty">No models indexed yet.</p>
    }
    else
    {
        @* One grid for all days: a small calendar tile starts each day, so days with few models leave no gaps. *@
        <div class="card-grid card-grid--days">
            @foreach (var group in Model.Models.GroupBy(f => DateOnly.FromDateTime(f.Modified.LocalDateTime)))
            {
                var day = group.Key;
                var label = day == today ? "Today" : day == today.AddDays(-1) ? "Yesterday" : day.ToString("dddd", culture);
                <div class="day-tile" role="heading" aria-level="2">
                    <span class="day-tile-label">@label</span>
                    <span class="day-tile-day">@day.Day</span>
                    <span class="day-tile-month">@day.ToString(day.Year == today.Year ? "MMM" : "MMM yyyy", culture)</span>
                    <span class="day-tile-count">@Display.Plural(group.Count(), "model", "models")</span>
                </div>
                @foreach (var file in group)
                {
                    <partial name="_ModelCard" model="new ModelCard(file, ShowFolder: true)" />
                }
            }
        </div>
    }
</main>
