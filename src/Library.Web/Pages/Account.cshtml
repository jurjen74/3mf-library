@page "/account"
@model AccountModel

<main class="content @(Model.Required ? "login-page" : null)">
    @if (Model.Account is null)
    {
        <h1>Account</h1>
        <p>You're using the library from the home network, so you don't need to log in here.</p>
        @if (!Model.HasAccounts)
        {
            <p>To open it from outside your home, <a href="/setup">create an account</a>.</p>
        }
        else
        {
            <p class="muted">To change a password, <a href="/login">log in</a> with that account first.</p>
        }
    }
    else if (Model.Required)
    {
        <form class="login-card" method="post">
            <svg class="login-logo" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3ZM5 9.7l6 3.3v6.6l-6-3.3V9.7Zm8 9.9V13l6-3.3v6.6l-6 3.3Z" fill="currentColor"/></svg>
            <h1>Choose your own password</h1>
            <p class="muted">
                Welcome, <strong>@Model.Account.UserName</strong>. You logged in with a password someone else set for you;
                pick one only you know to continue.
            </p>
            <partial name="_PasswordFields" model="Model" />
            <button type="submit" class="button primary">Save and continue</button>
        </form>
        <form method="post" action="/logout" class="logout-form forced-logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="link-button">Log out instead</button>
        </form>
    }
    else
    {
        <h1>Account</h1>
        <p class="muted lead">
            Logged in as <strong>@Model.Account.UserName</strong>@(Model.Account.IsAdmin ? " (admin)" : "").
            @if (Model.Account.IsAdmin)
            {
                <a href="/users">Manage users</a>
            }
        </p>

        <form class="login-card account-card" method="post">
            <h2>Change password</h2>
            @if (Model.Changed)
            {
                <p class="notice" role="status">Password changed. Other devices have been logged out.</p>
            }
            <partial name="_PasswordFields" model="Model" />
            <button type="submit" class="button primary">Change password</button>
        </form>
    }

    @if (!Model.Required)
    {
        @* Shown by site.js; stored in this browser (head.js), so a phone and a computer can differ. *@
        <section class="login-card account-card device-settings" id="appearance" hidden>
            <h2>Appearance</h2>
            <label>
                <span>Theme on this device</span>
                <select id="theme-choice">
                    <option value="system">Same as the system</option>
                    <option value="light">Light</option>
                    <option value="dark">Dark</option>
                </select>
            </label>
        </section>

        @* Shown by site.js on computers (mouse or trackpad) only; the choice is stored in this browser, not the account. *@
        @if (Session.CanDownload(HttpContext))
        {
            <section class="login-card account-card device-settings" id="this-computer" hidden>
                <h2>This computer</h2>
                <label>
                    <span>Slicer for the "Open in…" button</span>
                    <select id="slicer-choice">
                        <option value="bambu">Bambu Studio</option>
                        <option value="orca">OrcaSlicer</option>
                        <option value="prusa">PrusaSlicer (local copy only)</option>
                        <option value="cura">UltiMaker Cura</option>
                        <option value="creality">Creality Print</option>
                        <option value="elegoo">ElegooSlicer</option>
                    </select>
                </label>
                <p class="muted small" id="slicer-note" hidden></p>
                <label class="remember">
                    <input type="checkbox" id="open-local">
                    <span>Open models from my local copy of the library</span>
                </label>
                <p class="muted small">
                    For a computer that has the 3D print folder synced too. The slicer then opens and saves your actual file
                    instead of a downloaded copy. Needs the small helper from the repository, installed once:
                    <code>tools/mac-opener/build.sh</code> on a Mac, <code>tools\windows-opener\install.ps1</code> on Windows.
                    These settings only affect this browser on this computer.
                </p>
            </section>
        }
    }
</main>
