@page "/setup"
@model SetupModel
@inject LibraryOptions Options

<main class="content login-page">
    @if (!Model.Allowed)
    {
        <div class="login-card">
            <svg class="login-logo" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3ZM5 9.7l6 3.3v6.6l-6-3.3V9.7Zm8 9.9V13l6-3.3v6.6l-6 3.3Z" fill="currentColor"/></svg>
            <h1>@Options.SiteTitle</h1>
            <p>No account has been created yet.</p>
            <p class="muted">
                For safety, the first account can only be created directly on the site's own address, never through a
                proxy@(Options.TrustedNetworks.Count > 0 ? ", and only from the home network" : "").
            </p>
        </div>
    }
    else
    {
        <form class="login-card" method="post">
            <svg class="login-logo" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 3 7v10l9 5 9-5V7l-9-5Zm0 2.3L18.7 8 12 11.7 5.3 8 12 4.3ZM5 9.7l6 3.3v6.6l-6-3.3V9.7Zm8 9.9V13l6-3.3v6.6l-6 3.3Z" fill="currentColor"/></svg>
            <h1>Create your account</h1>
            <p class="muted">You'll use it to open the library from outside your home network. You can change the password later.</p>

            @if (Model.Error is not null)
            {
                <p class="login-error" role="alert">@Model.Error</p>
            }

            @if (Model.CodeRequired)
            {
                <label>
                    <span>Setup code <small class="muted">(in the container log: <code>docker logs 3mf-library</code>)</small></span>
                    <input asp-for="Code" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" maxlength="16" required autofocus>
                </label>
            }
            <label>
                <span>User name</span>
                <input asp-for="UserName" autocomplete="username" autocapitalize="none" spellcheck="false" maxlength="64" required autofocus="@(!Model.CodeRequired)">
            </label>
            <label>
                <span>Password <small class="muted">(at least @UserStore.MinimumPasswordLength characters)</small></span>
                <input asp-for="Password" type="password" autocomplete="new-password" minlength="@UserStore.MinimumPasswordLength" required>
            </label>
            <label>
                <span>Password again</span>
                <input asp-for="RepeatPassword" type="password" autocomplete="new-password" minlength="@UserStore.MinimumPasswordLength" required>
            </label>
            <button type="submit" class="button primary">Create account</button>
        </form>
    }
</main>
